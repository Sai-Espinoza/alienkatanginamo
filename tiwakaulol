-- Core Functions
local function sellSpecificPets()
    local petsFolder = LocalPlayer:FindFirstChild("petsFolder")
    if not petsFolder then return end

    local petsToSell = {}

    local function collectPetsFromCategory(categoryName, petName)
        local categoryFolder = petsFolder:FindFirstChild(categoryName)
        if categoryFolder then
            for _, pet in ipairs(categoryFolder:GetChildren()) do
                if pet.Name == petName then
                    table.insert(petsToSell, pet)
                end
            end
        end
    end

    collectPetsFromCategory("Epic", "Alien Slime")
    collectPetsFromCategory("Basic", "Cosmic Invader")
    collectPetsFromCategory("Unique", "UFO Bot")
    collectPetsFromCategory("Unique", "Galactic Overlord")

    if #petsToSell > 0 then
        pcall(function()
            sellPetEvent:FireServer(table.unpack({
                [1] = "sellPets",
                [2] = petsToSell,
            }))
        end)
    end
end

local function claimChestAndDrop()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    local alienChest = Workspace:FindFirstChild("Alien Chest")
    if alienChest and hrp and _G.AutoClaimChest then
        hrp.CFrame = alienChest:GetPivot() * CFrame.new(0, 3, 0)
        task.wait(0.2)
        
        pcall(function()
            firesignal(alienChestRemote.OnClientEvent, table.unpack({
                [1] = alienChest,
                [2] = "UFO Bot",
                [3] = "Pet",
                [4] = "Unique",
                [5] = 60,
            }))
        end)
    end

    task.wait(0.5)
    if _G.AutoSellPet then
        sellSpecificPets()
    end

    if hrp then
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

-- Button Click Events
