-- Helper function para sa paggawa ng Toggle Buttons
local function createToggleButton(name, text, positionY, defaultState)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, 180, 0, 35)
    btn.Position = UDim2.new(0.5, -90, 0, positionY)
    btn.BackgroundColor3 = defaultState and Color3.fromRGB(45, 170, 75) or Color3.fromRGB(180, 45, 45)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Text = text .. (defaultState and ": ON" or ": OFF")
    btn.Parent = MainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

