-- Main Loop
task.spawn(function()
    local wasFighting = false
    while true do
        if _G.AutoAlienBoss then
            local alienBoss = Workspace:FindFirstChild("Alien Boss")
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if alienBoss and char and hrp then
                local hitbox = alienBoss:FindFirstChild("BossDamageHitbox", true)
                local bossPart = alienBoss:FindFirstChild("Boss")

                if not (bossPart and bossPart:IsA("BasePart")) then
                    bossPart = hitbox
                end

                local health = bossPart and bossPart:GetAttribute("Health")

                if bossPart and (typeof(health) ~= "number" or health > 0) then
                    wasFighting = true
                    local offsetY = (bossPart.Size.Y / 2) + 3
                    hrp.CFrame = bossPart.CFrame * CFrame.new(0, offsetY, 0)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero

                    local backpack = LocalPlayer:FindFirstChild("Backpack")
                    local punch = char:FindFirstChild("Punch") or (backpack and backpack:FindFirstChild("Punch"))
                    if punch and punch.Parent ~= char then
                        punch.Parent = char
                    end

                    local leftHand = char:FindFirstChild("LeftHand")
                    local rightHand = char:FindFirstChild("RightHand")

                    if leftHand then
                        muscleEvent:FireServer("punch", leftHand)
                    end
                    if rightHand then
                        muscleEvent:FireServer("Punch", rightHand)
                    end
                elseif wasFighting then
                    wasFighting = false
                    claimChestAndDrop()
                end
            elseif wasFighting then
                wasFighting = false
                claimChestAndDrop()
            end
        end

        task.wait(_G.HitInterval)
    end
end)
